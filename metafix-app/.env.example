# Public address doctors and patients open (point its DNS A record at the server)
DOMAIN=app.metafix.clinic
SECRET_KEY=change-me-long-random
BASE_URL=https://app.metafix.clinic
ALLOWED_DOMAIN=metafix.clinic
POSTGRES_PASSWORD=change-me
BOOKING_WEBHOOK_SECRET=change-me
# live | fake  (fake = record messages/calendar/drive locally, send nothing)
INTEGRATIONS_MODE=live
DEV_LOGIN=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_ROOT_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/drive-service-account.json
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=care@metafix.clinic
# local | s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
INTAKE_GRACE_DAYS=7
